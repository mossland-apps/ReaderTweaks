---
import { SECTIONS } from '../lib/sections';
import { loadBrands } from '../lib/content';
const brands = await loadBrands();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="newsletter">
      <div>
        <p class="eyebrow">The ReaderTweaks letter</p>
        <h2>One email when something worth reading goes up.</h2>
        <p class="newsletter__sub">
          New device guides and the occasional firmware note. No spam, no more than
          twice a month, unsubscribe in one click.
        </p>
      </div>
      <div class="newsletter__signup">
        <form
          class="newsletter__form"
          action="https://app.kit.com/forms/9860502/subscriptions"
          method="post"
          data-newsletter
        >
          <label for="nl-email" class="visually-hidden">Email address</label>
          <input
            id="nl-email"
            type="email"
            name="email_address"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
          <button type="submit" class="btn">Subscribe</button>
        </form>
        <p class="newsletter__msg" data-newsletter-msg role="status" aria-live="polite" hidden></p>
      </div>
    </div>

    <nav class="footer-cols" aria-label="Footer">
      <div>
        <h3>Devices</h3>
        <ul>
          {brands.map((b) => (
            <li><a href={`/devices/${b.slug}/`}>{b.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Sections</h3>
        <ul>
          {SECTIONS.map((s) => (
            <li><a href={`/guides/#${s.slug}`}>{s.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Learn</h3>
        <ul>
          <li><a href="/guides/">All guides</a></li>
          <li><a href="/accessories/">Accessories</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </div>
      <div>
        <h3>Site</h3>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/about/#disclosure">Affiliate disclosure</a></li>
          <li><a href="/about/#contact">Contact</a></li>
        </ul>
      </div>
    </nav>

    <div class="footer-base">
      <p>&copy; {year} ReaderTweaks. Independent and not affiliated with any device maker.</p>
      <p>
        Some links are affiliate links. If you buy through them we may earn a
        commission at no extra cost to you.
      </p>
    </div>
  </div>
</footer>

<script>
  // Progressive enhancement for the Kit (ConvertKit) newsletter form.
  // Without JS the form posts straight to Kit and Kit shows its own
  // "check your email" page; with JS we keep the visitor on the site.
  const form = document.querySelector<HTMLFormElement>('form[data-newsletter]');
  const msg = document.querySelector<HTMLParagraphElement>('[data-newsletter-msg]');

  if (form && msg) {
    const button = form.querySelector('button');
    const buttonLabel = button?.textContent ?? 'Subscribe';

    const show = (text: string, ok: boolean) => {
      msg.textContent = text;
      msg.hidden = false;
      msg.classList.toggle('is-error', !ok);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      msg.hidden = true;
      if (button) {
        button.disabled = true;
        button.textContent = 'Subscribing…';
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        let data: {
          status?: string;
          message?: string;
          errors?: { messages?: string[] };
        } = {};
        try {
          data = await res.json();
        } catch {
          /* Kit occasionally returns an empty body */
        }

        if (data.status === 'success') {
          form.hidden = true;
          show(
            "Almost there — we've sent a confirmation email. Click the link in it to finish subscribing.",
            true,
          );
          return;
        }

        show(
          data.errors?.messages?.[0] ||
            data.message ||
            'That did not go through. Check the address and try again.',
          false,
        );
      } catch {
        show(
          'Could not reach the mailing service. Try again in a moment, or email hello@readertweaks.com.',
          false,
        );
      }

      if (button) {
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    });
  }
</script>

<style>
  .site-footer {
    background: var(--bg-sunk);
    border-top: 1px solid var(--rule);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    margin-top: 2rem;
  }
  .newsletter {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: end;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .newsletter h2 { font-size: var(--step-2); max-width: 22ch; }
  .newsletter__sub { color: var(--ink-soft); font-size: var(--step--1); max-width: 44ch; margin: 0; }
  .newsletter__signup { align-self: end; }
  .newsletter__form { display: flex; gap: 0.6rem; }
  .newsletter__form input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
  }
  .newsletter__form input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .newsletter__form button[disabled] { opacity: 0.6; cursor: default; }
  .newsletter__msg {
    margin: 0.75rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--accent-deep);
  }
  .newsletter__msg.is-error { color: #9a3412; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .newsletter__msg.is-error { color: #f0a67d; }
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding-block: 2.5rem;
  }
  .footer-cols h3 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.9rem;
  }
  .footer-cols ul { list-style: none; margin: 0; padding: 0; }
  .footer-cols li { margin-bottom: 0.5rem; }
  .footer-cols a {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .footer-cols a:hover { color: var(--accent); }

  .footer-base {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
    color: var(--ink-faint);
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }
  .footer-base p { margin: 0.2rem 0; }

  @media (max-width: 820px) {
    .newsletter { grid-template-columns: 1fr; align-items: start; gap: 1.2rem; }
    .footer-cols { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  }
  @media (max-width: 480px) {
    .newsletter__form { flex-direction: column; }
  }
</style>
