---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccessoryList from '../../components/AccessoryList.astro';
import AffiliateNote from '../../components/AffiliateNote.astro';
import { loadAccessories, loadDevices } from '../../lib/content';
import { breadcrumbJsonLd } from '../../lib/seo';

const accessories = await loadAccessories();
const devices = await loadDevices();
---

<BaseLayout
  title="Accessories"
  description="Cases, styluses, reading lights and other e-reader accessories worth owning, with notes on fit per device."
  path="/accessories/"
  activeNav="accessories"
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Accessories', path: '/accessories/' },
  ])}
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Accessories</p>
        <h1>Accessories worth owning</h1>
        <p class="lede">
          Short, opinionated picks. Device-specific accessories also appear on
          each device's own Accessories tab.
        </p>
        <AffiliateNote />
      </div>

      <AccessoryList accessories={accessories} devices={devices} showDisclosure={false} />
    </div>
  </section>
</BaseLayout>

<style>
  .section-head { margin-bottom: 2.5rem; max-width: 58ch; }
  .section-head h1 { font-size: var(--step-3); }
</style>
