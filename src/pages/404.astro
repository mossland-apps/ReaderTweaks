---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadBrands } from '../lib/content';

const brands = await loadBrands();
---

<BaseLayout
  title="Page not found"
  description="That page could not be found on ReaderTweaks."
  path="/404/"
  noindex
>
  <section class="section">
    <div class="wrap narrow prose">
      <p class="eyebrow">404</p>
      <h1>That page isn't here</h1>
      <p class="lede">
        The link may be old, or the page may not have been written yet. Try one
        of these instead.
      </p>

      <ul class="nf-links">
        <li><a href="/">Home</a></li>
        <li><a href="/devices/">All devices</a></li>
        <li><a href="/guides/">Guides</a></li>
        <li><a href="/search/">Search</a></li>
      </ul>

      <h2>Jump to a brand</h2>
      <ul class="nf-brands">
        {brands.map((b) => (
          <li><a href={`/devices/${b.slug}/`}>{b.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 640px; }
  .prose h1 { font-size: var(--step-3); }
  .nf-links,
  .nf-brands {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
  }
  .nf-links a,
  .nf-brands a {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0.4rem 0.85rem;
    color: var(--ink);
  }
  .nf-links a:hover,
  .nf-brands a:hover {
    border-color: var(--accent);
    background: var(--accent-tint);
  }
  .prose h2 { margin-top: 2rem; }
</style>
