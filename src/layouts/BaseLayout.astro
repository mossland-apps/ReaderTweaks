---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, canonical, truncateMeta } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  activeNav?: 'devices' | 'guides' | 'accessories' | 'about';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description, path, activeNav, jsonLd, noindex } = Astro.props;
const fullTitle = path === '/' ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
const desc = truncateMeta(description);
const url = canonical(path);
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Cloudflare Web Analytics — privacy-friendly, cookieless. The beacon only
// loads when PUBLIC_CF_BEACON_TOKEN is set in the Cloudflare Pages project.
const cfBeaconToken = (import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined)?.trim();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Guides`} href="/rss.xml" />

    {ldBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader active={activeNav} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <dialog id="leaving-site" class="leaving" aria-labelledby="leaving-title">
      <div class="leaving__box">
        <h2 id="leaving-title" class="leaving__title">You&rsquo;re leaving ReaderTweaks</h2>
        <p class="leaving__body">This link opens another website in a new tab:</p>
        <p class="leaving__host"><span data-leaving-host></span></p>
        <p class="leaving__note">
          We don&rsquo;t run that site and can&rsquo;t vouch for its content. This page stays
          open in your current tab.
        </p>
        <div class="leaving__actions">
          <button type="button" class="btn btn--ghost" data-leaving-cancel autofocus>Stay here</button>
          <button type="button" class="btn" data-leaving-continue>Continue to site</button>
        </div>
      </div>
    </dialog>

    <script>
      (() => {
        const dialog = document.getElementById('leaving-site');
        if (!dialog || dialog.dataset.wired === '1') return;
        dialog.dataset.wired = '1';

        const hostEl = dialog.querySelector('[data-leaving-host]');

        const isInternalHost = (h) =>
          h === location.host || h === 'readertweaks.com' || h === 'www.readertweaks.com';

        function outboundUrl(a) {
          const href = a.getAttribute('href');
          if (!href) return null;
          let u;
          try {
            u = new URL(href, location.href);
          } catch {
            return null;
          }
          if (u.protocol !== 'http:' && u.protocol !== 'https:') return null;
          if (isInternalHost(u.host)) return null;
          return u;
        }

        // Belt-and-braces: make sure every outbound link opens in a new tab, has
        // a safe rel and carries the marker — including hardcoded template links
        // the build step doesn't rewrite.
        document.querySelectorAll('a[href]').forEach((a) => {
          if (a.dataset.external !== undefined) return;
          if (!outboundUrl(a)) return;
          a.dataset.external = '';
          a.target = '_blank';
          const rel = new Set((a.getAttribute('rel') || '').split(/\s+/).filter(Boolean));
          rel.add('noopener');
          rel.add('noreferrer');
          rel.add('nofollow');
          a.setAttribute('rel', [...rel].join(' '));
          a.classList.add('is-external');
        });

        function openInNewTab(url) {
          window.open(url, '_blank', 'noopener,noreferrer');
        }

        function closeDialog() {
          dialog.dataset.url = '';
          if (dialog.open) dialog.close();
        }

        function confirmLeave(u) {
          if (typeof dialog.showModal !== 'function') {
            if (window.confirm('You are leaving ReaderTweaks to visit ' + u.host + '. Continue?')) {
              openInNewTab(u.href);
            }
            return;
          }
          dialog.dataset.url = u.href;
          if (hostEl) hostEl.textContent = u.host;
          dialog.showModal();
        }

        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target.closest && e.target.closest('a[href]');
          if (!a || dialog.contains(a)) return;
          const u = outboundUrl(a);
          if (!u) return;
          e.preventDefault();
          confirmLeave(u);
        });

        dialog.querySelector('[data-leaving-continue]').addEventListener('click', () => {
          const url = dialog.dataset.url;
          closeDialog();
          if (url) openInNewTab(url);
        });
        dialog.querySelector('[data-leaving-cancel]').addEventListener('click', closeDialog);

        // Esc and a click on the backdrop both just close.
        dialog.addEventListener('cancel', () => {
          dialog.dataset.url = '';
        });
        dialog.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            e.preventDefault();
            closeDialog();
          }
        });
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) closeDialog();
        });
      })();
    </script>

    {cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}
  </body>
</html>
