# Build-time settings. In production these are set in the Cloudflare Pages
# project under Settings -> Environment variables (Production), then a redeploy.
# All are optional — the site builds and runs without them.

# Amazon Associates tracking id, e.g. readertweaks-20.
# When set, every "Find on Amazon" link carries it.
PUBLIC_AMAZON_TAG=

# Cloudflare Web Analytics site token (Cloudflare dashboard -> Analytics ->
# Web Analytics -> add site). When set, the cookieless beacon is included.
PUBLIC_CF_BEACON_TOKEN=
