{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src", "tests", "*.config.*"],
  "exclude": ["dist", "node_modules"]
}
